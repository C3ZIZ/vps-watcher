# vps-watcher settings. After editing: sudo systemctl restart vps-watcher

# Address of the web UI. Keep 127.0.0.1 and put Caddy or nginx in front for public access.
VPSW_LISTEN=127.0.0.1:9100

# login = every page needs the admin. open = anyone can view; only the admin can change things.
VPSW_AUTH=login

# In open mode, also show logs and process command lines to visitors (they can contain secrets).
VPSW_OPEN_LOGS=false

# Your public domain, used by: sudo vps-watcher proxy caddy   (or: proxy nginx)
VPSW_DOMAIN=

# Seconds between samples (1-60). Lower means more detail and slightly more CPU.
VPSW_INTERVAL=5

# Addresses whose X-Forwarded-For header is trusted (your reverse proxy).
VPSW_TRUSTED_PROXIES=127.0.0.1,::1

# Where the admin account, monitors and history are stored.
VPSW_DATA_DIR=/var/lib/vps-watcher

# Docker socket. Leave as is; a missing socket simply means no containers.
VPSW_DOCKER_SOCKET=/var/run/docker.sock

# ---------- Alerts ----------
# Alerts show on the Alerts page even with no email or webhook set up.

# Alert when CPU or memory stay at or above this percent for VPSW_ALERT_AFTER minutes. "off" disables.
VPSW_ALERT_CPU=90
VPSW_ALERT_MEMORY=90
VPSW_ALERT_AFTER=5

# A spike near exhaustion alerts after just one minute (critical), for CPU and memory.
VPSW_ALERT_SPIKE=98

# Alert when the 1-minute load stays above this many per CPU core for VPSW_ALERT_AFTER minutes.
VPSW_ALERT_LOAD=2

# Alert when a disk's space or inodes reach this percent.
VPSW_ALERT_DISK=90

# Alert when a container or service stops, turns unhealthy, restarts, runs out of memory or fails.
VPSW_ALERT_APPS=true

# ---------- Email alerts (SMTP) ----------
# Email turns on when VPSW_ALERT_EMAIL and VPSW_SMTP_HOST are both set. Guide: docs/alerts.md

# Who receives alerts, separated by commas.
VPSW_ALERT_EMAIL=

# Mail server, for example smtp.gmail.com or smtp.office365.com.
VPSW_SMTP_HOST=
# Empty means 587 (STARTTLS). Use 465 for TLS. VPSW_SMTP_SECURITY=starttls|tls|none overrides
# (none is only allowed without a password, or for a relay on this server).
VPSW_SMTP_PORT=
VPSW_SMTP_SECURITY=

# Sign-in. For Gmail use an app password (Google Account > Security > App passwords).
# Wrap the password in single quotes if it contains spaces or #.
VPSW_SMTP_USER=
VPSW_SMTP_PASSWORD=

# Sender address. Empty means VPSW_SMTP_USER.
VPSW_SMTP_FROM=

# OAuth2 instead of a password (Microsoft 365, Gmail). Leave VPSW_SMTP_PASSWORD empty when using these.
# The token URL is filled in for Gmail and Microsoft; set it for other providers or a single-tenant app.
VPSW_SMTP_OAUTH_CLIENT_ID=
VPSW_SMTP_OAUTH_CLIENT_SECRET=
VPSW_SMTP_OAUTH_REFRESH_TOKEN=
VPSW_SMTP_OAUTH_TOKEN_URL=

# Email a usage report (averages, peaks, busiest apps, disk forecast): off, daily or weekly.
# The Reports page can also email one on demand.
VPSW_REPORT=off

# ---------- Webhook alerts ----------
# Slack, Discord, ntfy or your own endpoint. The format is picked from the URL;
# override with VPSW_WEBHOOK_FORMAT=json|slack|discord|text.
VPSW_WEBHOOK_URL=
VPSW_WEBHOOK_FORMAT=

# Optional: sign JSON bodies with this key (X-Vpsw-Signature header), and/or send "Authorization: Bearer <token>".
VPSW_WEBHOOK_SECRET=
VPSW_WEBHOOK_TOKEN=

# After editing: sudo vps-watcher config   (checks the file, hides secrets)
#                sudo systemctl restart vps-watcher
#                sudo vps-watcher test-alert
