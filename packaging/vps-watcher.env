# vps-watcher settings. After editing: sudo systemctl restart vps-watcher

# Address of the web UI. Keep 127.0.0.1 and put Caddy or nginx in front for public access.
VPSW_LISTEN=127.0.0.1:9100

# login = every page needs the admin. open = anyone can view; only the admin can change things.
VPSW_AUTH=login

# In open mode, also show logs and process command lines to visitors (they can contain secrets).
VPSW_OPEN_LOGS=false

# Your public domain, used by: sudo vps-watcher proxy caddy   (or: proxy nginx)
VPSW_DOMAIN=

# Seconds between samples (1-60). Lower means more detail and slightly more CPU.
VPSW_INTERVAL=5

# Addresses whose X-Forwarded-For header is trusted (your reverse proxy).
VPSW_TRUSTED_PROXIES=127.0.0.1,::1

# Where the admin account, monitors and history are stored.
VPSW_DATA_DIR=/var/lib/vps-watcher

# Docker socket. Leave as is; a missing socket simply means no containers.
VPSW_DOCKER_SOCKET=/var/run/docker.sock
